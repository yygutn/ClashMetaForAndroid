diff --git a/tunnel/tunnel.go b/tunnel/tunnel.go
index 470f729..d3933ee 100644
--- a/tunnel/tunnel.go
+++ b/tunnel/tunnel.go
@@ -474,7 +474,7 @@ func handleUDPConn(packet C.PacketAdapter) {
 			}
 			logMetadata(metadata, rule, rawPc)
 
-			pc := statistic.NewUDPTracker(rawPc, statistic.DefaultManager, metadata, rule, 0, 0, true)
+			pc := statistic.NewUDPTracker(rawPc, statistic.DefaultManager, metadata, rule, 0, 0, shouldPushToManager(rawPc))
 
 			sender.AddMapping(originMetadata, dialMetadata)
 			oAddrPort := dialMetadata.AddrPort()
@@ -610,7 +610,7 @@ func handleTCPConn(connCtx C.ConnContext) {
 	}
 	logMetadata(metadata, rule, remoteConn)
 
-	remoteConn = statistic.NewTCPTracker(remoteConn, statistic.DefaultManager, metadata, rule, int64(peekLen), 0, true)
+	remoteConn = statistic.NewTCPTracker(remoteConn, statistic.DefaultManager, metadata, rule, int64(peekLen), 0, shouldPushToManager(remoteConn))
 	defer func(remoteConn C.Conn) {
 		_ = remoteConn.Close()
 	}(remoteConn)
@@ -622,6 +622,22 @@ func handleTCPConn(connCtx C.ConnContext) {
 	handleSocket(conn, remoteConn)
 }
 
+// shouldPushToManager reports whether a connection's traffic should count toward
+// global notification statistics. Direct, reject, and other non-proxy outbounds
+// are excluded so only proxied traffic is shown.
+func shouldPushToManager(conn C.Connection) bool {
+	chains := conn.Chains()
+	if len(chains) == 0 {
+		return false
+	}
+	switch chains[0] {
+	case "DIRECT", "COMPATIBLE", "REJECT", "REJECT-DROP":
+		return false
+	default:
+		return true
+	}
+}
+
 func logMetadataErr(metadata *C.Metadata, rule C.Rule, proxy C.ProxyAdapter, err error) {
 	if rule == nil {
 		log.Warnln("[%s] dial %s %s --> %s error: %s", strings.ToUpper(metadata.NetWork.String()), proxy.Name(), metadata.SourceDetail(), metadata.RemoteAddress(), err.Error())
